# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False

# Live Website Domain (Used in Emails & Redirects)
SITE_URL=https://your-project.vercel.app

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Leave empty locally (uses SQLite automatically)
# On Vercel: paste your PostgreSQL connection string from Neon / Supabase / Vercel Postgres
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# MongoDB Database Connection (secondary sync / audit logs)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=schemesetu

# EmailJS Service Configuration
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_WELCOME_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your-public-key
EMAILJS_PRIVATE_KEY=your-private-key
